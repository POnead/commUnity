NODE_ENV=development
PORT=8768
# Calendar days, deadlines and reminders follow this zone. Change only for another municipality.
APP_TIME_ZONE=Asia/Manila
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:8768
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
UPLOADS_DIR=./data/uploads
# Optional: PEM CA bundle for a managed PostgreSQL provider with a private certificate (for example Amazon RDS).
# DATABASE_CA=

# Optional SMTP email delivery. If SMTP_SETTINGS_KEY is unset, the server generates
# a random key file next to the data directory so email works with no setup.
# Set SMTP_SETTINGS_KEY only if you want to manage that key yourself.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CommUnity <no-reply@example.com>
SMTP_SETTINGS_KEY=
# Optional HTTPS email delivery (Resend). Use this when SMTP ports are blocked but
# HTTPS (443) works, e.g. on restricted Wi-Fi. Takes precedence over SMTP when set.
# Get a key at https://resend.com/api-keys. RESEND_FROM must be a verified sender
# (a verified domain, or onboarding@resend.dev for testing to your own address).
RESEND_API_KEY=
RESEND_FROM=

# Optional third-party verification. Blank keys keep verification fully local.
# OCR.space reads resident ID images; Face++ compares staff face images.
# FACEPP_API_BASE must match the account's region: api.faceplusplus.com (international),
# api-us.faceplusplus.com, api-cn.faceplusplus.com, or api-uk.faceplusplus.com.
# A wrong region typically returns 403 even with valid keys.
OCR_API_KEY=
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_API_BASE=https://api.faceplusplus.com

# Google Maps JavaScript API key for the Palsara map pickers. Referrer-restrict it in Google Cloud.
GOOGLE_MAPS_API_KEY=
