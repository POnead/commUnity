NODE_ENV=development
PORT=8768
# Calendar days, deadlines and reminders follow this zone. Change only for another municipality.
APP_TIME_ZONE=Asia/Manila
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:8768
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
UPLOADS_DIR=./data/uploads

# Optional SMTP email delivery. If SMTP_SETTINGS_KEY is unset, the server generates
# a random key file next to the data directory so email works with no setup.
# Set SMTP_SETTINGS_KEY only if you want to manage that key yourself.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CommUnity <no-reply@example.com>
SMTP_SETTINGS_KEY=
