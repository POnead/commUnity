{
  "name": "community-portal",
  "version": "1.0.0",
  "description": "Local CommUnity portal with a Node.js server and PGlite database.",
  "private": true,
  "main": "server/index.mjs",
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test \"test/*.test.mjs\" ./postgres-migration.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1"
  }
}
